<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Prevent rewrite loop
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # 1. Specific API / Page routes
    RewriteRule ^auth/login/?$ api/auth.php [L,QSA]
    RewriteRule ^checkout/?$ checkout.php [L,QSA]
    RewriteRule ^orders/?$ orders.php [L,QSA]

    # 2. Route /home to index.php internally
    RewriteRule ^home/?$ index.php [L,QSA]

    # 3. Redirect root or index.php to /home (GET/HEAD only)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ \S*(?:/|index(?:\.php)?)\ HTTP/ [NC]
    RewriteCond %{REQUEST_URI} ^/(?:(.*)/)?(?:index(?:\.php)?)?$ [NC]
    RewriteRule ^(index(?:\.php)?|)$ /%1home [R=301,L]

    # 4. Redirect *.php directly requested in browser to clean extensionless URL (GET/HEAD only)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ \S+\.php [NC]
    RewriteCond %{REQUEST_URI} !^.*/index\.php$ [NC]
    RewriteCond %{REQUEST_URI} ^/(.+)\.php$ [NC]
    RewriteRule ^(.+)\.php$ /%1 [R=301,L]

    # 5. Internally rewrite extensionless requests to .php if the file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
